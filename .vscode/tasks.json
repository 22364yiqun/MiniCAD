{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "process",
      "command": "${workspaceFolder}/qt/Tools/CMake_64/bin/cmake.exe",
      "args": ["--preset", "vscode-debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "CMake: build",
      "type": "process",
      "command": "${workspaceFolder}/qt/Tools/CMake_64/bin/cmake.exe",
      "args": ["--build", "--preset", "vscode-debug", "--target", "minicad_qt"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "CMake: configure",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
